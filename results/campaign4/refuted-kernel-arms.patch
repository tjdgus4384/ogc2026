+// packContact -- normalised shared-boundary length between a candidate
+// bbox [cx0,cx1]x[cy0,cy1] and (a) the four bay walls and (b) each
+// time-overlapping resident bbox (rbs, absolute frame, from rbCollect).
+// An edge pair counts as touching when the perpendicular gap is
+// <=1e-6; the contribution is the overlapping parallel span. The sum
+// is normalised by the candidate's own perimeter so the result is a
+// dimensionless in-[0, ~) contact fraction, used only when
+// knobs::packW() > 0 (OGC_PACK tie-and-near-tie discriminator).
+inline double packContact(double W, double H,
+                           double cx0, double cx1, double cy0, double cy1,
+                           const std::vector<RB>& rbs) {
+    double contact = 0.0;
+    if (std::fabs(cx0 - 0.0) <= 1e-6) contact += (cy1 - cy0);
+    if (std::fabs(cx1 - W)   <= 1e-6) contact += (cy1 - cy0);
+    if (std::fabs(cy0 - 0.0) <= 1e-6) contact += (cx1 - cx0);
+    if (std::fabs(cy1 - H)   <= 1e-6) contact += (cx1 - cx0);
+    for (const RB& r : rbs) {
+        if (std::fabs(cx1 - r.x0) <= 1e-6 || std::fabs(cx0 - r.x1) <= 1e-6) {
