+// REGRET-K REINSERTION (opt-in, env OGC_REGRET -- knobs::regretCap()):
+// the fixed hardest-first sequential loop commits each removed block to
+// its first feasible spot without ever asking what that commitment costs
+// the blocks still waiting. Regret insertion asks: for every block still
+// out, what does its best insertBest placement cost, and how much worse
+// is its SECOND-best -- the price of deferring it another round. Insert
+// the block with the largest regret (biggest loss if delayed) each round;
+// repeat until every block lands or one has no legal placement left, in
+// which case the caller's existing rollback path takes over untouched.
+// `list` is left holding whatever remains placed by the block that
+// caused the failure (matching insertGreedy's contract: state is
+// modified up to and including the failing call, never rolled back
+// here -- rollback is the caller's job, same as today).
+inline bool regretReinsert(repair::Ctx& c, std::vector<int>& list, int maxCand) {
+    // ONE regret-scoring pass, then sequential insertion in that order.
+    // Recomputing regret after every commit is the textbook form, but it
+    // costs O(k^2) insertBest calls per destroy/repair iteration and the
+    // anneal pays for it in lost iterations (p36 s7, crane-exact variant:
+    // P4 +63%). Scoring once keeps the ordering signal at O(2k).
+    std::vector<std::pair<double,int>> order;
+    order.reserve(list.size());
+    for (int A : list) {
+        double cst = 0, snd = 0;
+        if (!repair::insertBest(c, A, -1, maxCand, &cst, &snd))
+            return false;                // truly infeasible: caller rolls back
+        repair::removeBlock(c, A);        // trial only -- undo before deciding
+        order.push_back({-(snd - cst), A});
+    }
+    std::sort(order.begin(), order.end());
+    for (auto& pr : order)
+        if (!repair::insertBest(c, pr.second, -1, maxCand, nullptr, nullptr))
+            return false;
+    return true;
+}
