+
+    std::vector<int> bays;
+    if (c.forcedBay && c.forcedBay[A] >= 0) bays.assign(1, c.forcedBay[A]);
+    else { bays.resize(pb.m); for (int j = 0; j < pb.m; j++) bays[j] = j; }
+    std::vector<int> oris(pb.geo[A].orients.size());
+    for (size_t o = 0; o < oris.size(); o++) oris[o] = (int)o;
+
+    // bay-preference shortfall reference: A's own best-achievable pref,
+    // regardless of which bay ends up feasible.
+    double prefBest = pb.pref[A][bays[0]];
+    for (int j : bays) prefBest = std::max(prefBest, pb.pref[A][j]);
+
+    const auto& g0 = pb.geo[A].orients[0];
+    double areaA = knobs::polyArea() && g0.parea > 0.0
+                   ? g0.parea
+                   : (g0.bb.x1 - g0.bb.x0) * (g0.bb.y1 - g0.bb.y0);
+
+    double bestCost = 0.0, secondCost = 0.0;
+    bool haveBest = false, haveSecond = false;
+    int bBay = -1, bOri = -1, bX = 0, bY = 0, bE = -1, bF = -1;
+    int found = 0;
+    thread_local std::vector<int> xs, ys;
+    int stride = (eTop - eBot <= 24) ? 1 : knobs::stride();
+    for (int e = eBot; e <= eTop && found < maxCand; e += stride) {
+        int f = e + pb.P[A];
+        for (int j : bays) {
+            if (found >= maxCand) break;
+            if (!areaRoom(c, j, areaA, e, f)) continue;
+            thread_local std::vector<RB> rbs;
+            rbCollect(c, j, e, f, rbs);
+            // same-layer snapshot prefilter as insertGreedy's fast phases:
+            // vpConservative below is still the verdict, but the O(1) bit
+            // test keeps the candidate scan affordable inside the anneal
+            // (the crane-exact occ::hits made this 8x slower than the
+            // first-fit path and the anneal lost more iterations than the
+            // better placements were worth -- p36 s7 measured P4 +63%).
+            thread_local occ::OccIndex::Snap sn;
+            c.oc->buildSnap(j, e, f, sn);
+            for (int oi : oris) {
+                if (found >= maxCand) break;
+                cornerSetsRB(c, A, oi, j, rbs, xs, ys);
+                for (int y : ys) {
+                    if (found >= maxCand) break;
+                    for (int x : xs) {
+                        if (found >= maxCand) break;
+                        if (c.oc->hitsSnap(sn, A, oi, x, y)) continue;
+                        s.bay[A]=j; s.ori[A]=oi; s.x[A]=x; s.y[A]=y;
+                        s.e[A]=e; s.f[A]=f; s.placed[A]=1;
+                        bool ok = core::vpConservative(pb, s, A);
+                        s.placed[A] = 0;         // evaluate only, never commit here
+                        if (!ok) continue;
+                        found++;
+                        // weighted tardiness at this candidate entry
+                        double cost = pb.w1 * (double)std::max(0, f - pb.D[A]);
+                        // bay-preference shortfall vs A's own best preference
+                        cost += pb.w3 * (prefBest - pb.pref[A][j]);
+                        // tie-break: earlier entry, then lower-left compact
+                        // position -- scaled far below w1/w3 so it can only
+                        // ever decide between otherwise-equal candidates.
+                        cost += 1e-6 * (double)e + 1e-9 * (double)(x + y);
+                        if (knobs::packW() > 0) {
+                            // packing-quality term: rewards dense/contact
+                            // placements and a bottom-left bias, scaled by
+                            // pb.w3 so packW()<=100 stays well below one
+                            // w1 tardiness-day and below real w3 pref
+                            // differences -- tie-and-near-tie discriminator
+                            // only, never overriding tardiness or pref.
+                            const auto& gA = pb.geo[A].orients[oi];
+                            double cx0 = (double)x + gA.bb.x0, cx1 = (double)x + gA.bb.x1;
+                            double cy0 = (double)y + gA.bb.y0, cy1 = (double)y + gA.bb.y1;
+                            double W = pb.bayW[j], H = pb.bayH[j];
+                            double contact = packContact(W, H, cx0, cx1, cy0, cy1, rbs);
+                            double blBias = (W + H) > 1e-9
+                                          ? (double)(x + y) / (W + H) : 0.0;
+                            double packScale = knobs::packW() * 0.01 * pb.w3;
+                            cost += packScale * (blBias - contact);
+                        }
+                        if (!haveBest || cost < bestCost) {
+                            if (haveBest) { secondCost = bestCost; haveSecond = true; }
+                            bestCost = cost; haveBest = true;
+                            bBay=j; bOri=oi; bX=x; bY=y; bE=e; bF=f;
+                        } else if (!haveSecond || cost < secondCost) {
+                            secondCost = cost; haveSecond = true;
+                        }
+                    }
+                }
+            }
+        }
+    }
+    if (!haveBest) return false;
+    if (!haveSecond) secondCost = bestCost;
+    s.bay[A]=bBay; s.ori[A]=bOri; s.x[A]=bX; s.y[A]=bY;
+    s.e[A]=bE; s.f[A]=bF; s.placed[A]=1;
+    s.addIdx(A);
+    c.oc->stamp(pb, s, A, true);
+    if (outCost)   *outCost   = bestCost;
+    if (outSecond) *outSecond = secondCost;
+    return true;
+}
 
