# local conda environment (rebuildable -- see README.md)
.miniforge/

# python bytecode
__pycache__/
*.pyc

# scratch / transient
scratchpad/
.claude/scheduled_tasks.lock
slurm-*.out
runs/
.gjc/

# credentials -- never commit
gurobi.lic

# NOTE: *.so is deliberately TRACKED. The compiled kernel is the shipped
# artifact and is only ~700KB. Losing a kernel binary once already cost a whole
# generation of work -- see archive/notes-2026-06/SOURCE_RECOVERY_NOTE.md.

# experiment builds: source is tracked, binaries are not
archive/exp/*/sscore*.so

# isolated probe/ship builds (source is tracked as patches under results/)
builds/
