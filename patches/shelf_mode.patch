 // candidate x/y sets from "corner points": bay walls and edges of present
 // blocks (their union-bbox), plus the block's own previous position.
+
+// sec 168: SHELF/ROW representation probe. Restrict y-candidates to multiples
+// of shelfH (snap corner-derived ys DOWN to their shelf line, dedup). The
+// hypothesis: sec 155 showed 99% of sequencing tardiness is crane-involved,
+// and diagNoCrane frees only 8-9% BECAUSE the measured layouts were already
+// shaped by crane-feasible history -- a layout FAMILY with built-in corridors
+// may avoid those blockings from the start, trading raw density for flow.
+// Unlike a seed (sec 165), this constrains the whole search space, so the
+// operators stay consistent with the family.
+inline void shelfFilter(const Ctx& c, std::vector<int>& ys) {
+    if (c.shelfH <= 0) return;
+    thread_local std::vector<int> t; t.clear();
+    for (int y : ys) {
+        int q = y >= 0 ? (y / c.shelfH) * c.shelfH
+                       : -(((-y) + c.shelfH - 1) / c.shelfH) * c.shelfH;
+        t.push_back(q);
+    }
+    std::sort(t.begin(), t.end());
+    t.erase(std::unique(t.begin(), t.end()), t.end());
+    ys.swap(t);
+}
