+            int pivot = col;
+            for (int r = col + 1; r < D; ++r)
+                if (std::fabs(w[r][col]) > std::fabs(w[pivot][col])) pivot = r;
+            if (std::fabs(w[pivot][col]) < 1e-12) continue;
