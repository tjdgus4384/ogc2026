+    std::array<double, D> solve(const std::array<double, D>& rhs) const {
+        std::array<std::array<double, D + 1>, D> w{};
+        for (int i = 0; i < D; ++i) {
+            for (int j = 0; j < D; ++j) w[i][j] = a[i][j];
+            w[i][D] = rhs[i];
