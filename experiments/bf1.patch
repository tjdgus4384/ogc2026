+// bf1: shared boundary between A-at-(oi,x,y) and everything already fixed in
+// the bay -- residents that touch it edge-on, plus the four walls. Longer
+// contact means the block is flush into the existing structure rather than
+// stranded mid-floor, which is what keeps the remaining free floor in one
+// piece. Costs O(|rbs|) and runs only on candidates that already cleared
+// hitsSnap, so it never adds a vpConservative call.
+struct BFCand { double score; int oi, x, y; };
+
+inline double contactScore(const Ctx& c, int A, int oi, int x, int y, int j,
+                           const std::vector<RB>& rbs) {
+    const Problem& pb = *c.pb;
+    const auto& g = pb.geo[A].orients[oi];
+    const double ax0 = g.bb.x0 + x, ax1 = g.bb.x1 + x;
+    const double ay0 = g.bb.y0 + y, ay1 = g.bb.y1 + y;
+    const double EPS = 1e-9;
+    double sc = 0.0;
+    if (ax0 <= EPS)                 sc += ay1 - ay0;      // left wall
+    if (ax1 >= pb.bayW[j] - EPS)    sc += ay1 - ay0;      // right wall
+    if (ay0 <= EPS)                 sc += ax1 - ax0;      // bottom wall
+    if (ay1 >= pb.bayH[j] - EPS)    sc += ax1 - ax0;      // top wall
+    for (const RB& r : rbs) {
+        if (std::fabs(r.x1 - ax0) < EPS || std::fabs(r.x0 - ax1) < EPS) {
+            double ov = std::min(r.y1, ay1) - std::max(r.y0, ay0);
+            if (ov > 0) sc += ov;
+        }
+        if (std::fabs(r.y1 - ay0) < EPS || std::fabs(r.y0 - ay1) < EPS) {
+            double ov = std::min(r.x1, ax1) - std::max(r.x0, ax0);
+            if (ov > 0) sc += ov;
+        }
+    }
+    return sc;
+}
