+def _jointcon(p):
+    """Day-by-day construction with each day's cohort seated JOINTLY.
+
+    The elimination that led here (ledger 08-13): every decomposed axis of the
+    incumbent pipeline is measured rigid -- per-bay packing optimal over the
+    vocabulary, no extra block fits at our positions, the board a compaction
+    fixpoint, rescheduling our own packings realizes nothing on a validated
+    instrument. What separates stronger boards must be built into the geometry
+    at construction: more blocks entering per day, packed jointly, than
+    sequential first-fit ever seats.
+
+    Each day, one CP chooses which waiting blocks enter and where: candidates
+    from feasible_positions at exactly that day, exclusions from
+    pair_conflicts (this build ships the corrected same-day tie model -- the
+    old one over-rejects same-day pairs, which is precisely what joint seating
+    mass-produces), urgency-weighted so a block at the edge of its punctual
+    window outweighs several with slack to spare.
+
+    Measured (08-13): beats the best-of-5 seed by 14% on P6 (demand 3x yard)
+    and keeps -4.4 to -7.1% through a budget-matched 400s anneal on all three
+    seeds tried; loses on P4/P5 at the seed level, so the caller must gate it
+    by seed objective, not hope. Cost ~4s. Returns a flat solution or None.
+    """
+    cp = _cpsat()
+    if cp is None:
+        return None
+    try:
+        _t0 = time.time()
+        B = p["blocks"]
+        n = len(B)
+        R = [int(math.ceil(b["release_time"] - 1e-9)) for b in B]
+        eng, D, P = _fresh(p, 4)
+        eng.set_solution([0] * (n * 7))
+        eng.build_occ(eng.horizon())
+        unplaced = set(range(n))
+        H = max(D) + 64
+        day = 0
+        while unplaced and day <= H:
+            # HARD TOTAL BUDGET. Per-day CP time is nondeterministic (CP-SAT
+            # multi-worker), and 150 days x 6s uncapped ate 8+ minutes on two
+            # of three screen arms while the third finished in one. Past the
+            # budget the walk stops and greedy seats the rest -- the joint
+            # structure built so far is kept.
+            if time.time() - _t0 > 45.0:
+                break
+            want = [i for i in unplaced if R[i] <= day]
+            if not want:
+                day += 1
+                continue
+            CAND, flat, idx = {}, [], []
+            for i in want:
+                raw = eng.feasible_positions(i, 6, day)
+                cs = [tuple(raw[k:k + 5]) for k in range(0, len(raw), 5)]
+                cs = [c for c in cs if c[4] == day]
+                if cs:
+                    CAND[i] = cs
+                    for k, c in enumerate(cs):
+                        flat += [i, c[0], c[1], c[2], c[3], c[4]]
+                        idx.append((i, k))
+            if not CAND:
+                day += 1
+                continue
+            mdl = cp.CpModel()
+            V, use = {}, {}
+            for i in CAND:
+                V[i] = [mdl.NewBoolVar(f"z{i}_{k}")
+                        for k in range(len(CAND[i]))]
+                use[i] = mdl.NewBoolVar(f"u{i}")
+                mdl.Add(sum(V[i]) == use[i])
+            prs = eng.pair_conflicts(flat)
+            for q in range(0, len(prs), 2):
+                (a1, k1), (a2, k2) = idx[prs[q]], idx[prs[q + 1]]
+                mdl.AddBoolOr([V[a1][k1].Not(), V[a2][k2].Not()])
+            # v1 objective: the true objective's own terms, per candidate.
+            # Entering today is worth the urgency value (a block at or past
+            # its punctual edge outweighs slack-rich ones); a candidate in a
+            # worse bay pays its ACTUAL preference regret (w3-scaled, the
+            # term v0 ignored -- measured Z3 explosions on P4/P5); and a tiny
+            # bottom-left bias keeps the floor compact for the NEXT days,
+            # which arbitrary corner choice was fragmenting.
+            B_ = p["blocks"]
+            w3 = p["weights"]["w3"]
+            terms = []
+            for i in CAND:
+                slack = (D[i] - P[i]) - day
+                urg = 3000 if slack <= 0 else max(1, 3000 // (1 + slack))
+                pr = B_[i]["bay_preferences"]
+                smax = max(pr)
+                for k, c in enumerate(CAND[i]):
+                    reg = int(round(smax - pr[c[0]]))
+                    corner = c[3] * 4 + c[2]        # y-major bottom-left
+                    terms.append((urg * 100 - w3 * reg - corner) * V[i][k])
+            mdl.Maximize(sum(terms))
+            sv = cp.CpSolver()
+            sv.parameters.max_time_in_seconds = 2.0
+            sv.parameters.num_search_workers = 4
+            if sv.Solve(mdl) in (2, 4):
+                for i in list(CAND):
+                    if sv.Value(use[i]):
+                        for k, c in enumerate(CAND[i]):
+                            if sv.Value(V[i][k]):
+                                if eng.place_at(i, c[0], c[1], c[2],
+                                                c[3], c[4]):
+                                    unplaced.discard(i)
+                                break
+            day += 1
+        # a handful of stragglers can outlive the calendar walk -- a large
+        # block near the horizon may never see a same-day candidate (measured:
+        # P6 block 49, P=28, alone after day 150). The joint structure is
+        # already built; let the kernel's own greedy seat the remainder.
+        for i in sorted(unplaced, key=lambda k: -P[k]):
+            if eng.insert_capped(i, -1, -1):
+                unplaced.discard(i)
+        if unplaced:
+            return None
+        return eng.get_solution()
+    except Exception:
+        return None
+
