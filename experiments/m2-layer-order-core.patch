 // is only valid while every placement passes through this function; an
 // operator writing placements directly must re-verify them (sec 176).
 
+// Intra-day ENTRY order. The crane lowers a block onto layer k and is blocked
+// by any resting block's layer j >= k, so a TALL neighbour already down
+// obstructs far more than a flat one: put the flat blocks in first and the
+// tall ones last. Layer count is orientation-independent in these instances,
+// so this key is a pure block property and cannot shift as the search re-
+// orients a block. _recs_to_sol emits same-day entries by this same key.
+inline bool entersBefore(const Problem& pb, int a, int b) {
+    const size_t la = pb.geo[a].orients[0].layers.size();
+    const size_t lb = pb.geo[b].orients[0].layers.size();
+    return la != lb ? la < lb : a < b;
+}
