+// sec 196: SLIDING COMPACTION. cornerSets proposes bbox-corner offsets, which
+// cannot express polygon interlock -- the named mechanism of the -34%
+// constructive gap (secs 164/165) and of the density ceiling (0.666 in situ
+// against 0.757 for a dedicated bottom-left nester, sec 163). Instead of
+// enlarging the candidate set (exhaustive scanning loses on throughput, sec
+// 169b) this SHARPENS each candidate: push it down and left until it actually
+// touches something. Only the cheap bitmask test drives the slide; vp runs
+// once at the end, and the un-slid position stays available as a fallback that
+// is already known to pass. Deterministic, and it cannot reduce density.
+inline void slideCompact(const Ctx& c, const occ::OccIndex::Snap& sn,
+                         int A, int oi, int j, int& x, int& y,
+                         double lox, double loy) {
+    for (int step = 0; step < 64; step++) {
+        bool moved = false;
+        if (y - 1 >= loy && !c.oc->hitsSnap(sn, A, oi, x, y - 1)) { y--; moved = true; }
+        if (x - 1 >= lox && !c.oc->hitsSnap(sn, A, oi, x - 1, y)) { x--; moved = true; }
+        if (!moved) break;
+    }
+}
